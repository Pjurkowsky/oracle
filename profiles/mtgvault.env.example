# MTG Vault binder scanner model (spec 001): ManaVault's phone-scanner pipeline, trained on
# binder glare, written to a local folder MTG Vault installs from. `mise run setup-mtgvault`
# copies this to ~/.config/cardid/mtgvault.env (chmod 600); then fill in the two paths.
CARDID_PROFILE=mtgvault
# MTG Vault does not send scans back, so there is no corrections server: an empty folder.
CARDID_CORRECTIONS_DIR=data/corrections-none
# Bundles land in <folder>/<version>, with `current` pointing at the newest. Create it first.
CARDID_PUBLISH_TO=/home/you/mtgvault-bundles
# The held-out gate scores binder photos only (cardid.capture --photos); they are never trained on.
CARDID_SOURCES=binder-photos
# Starting weights: Oracle's committed models (ManaVault's checkpoints are not public).
CARDID_CHECKPOINT=models/recogniser.pt
CARDID_DETECTOR=models/detector.pt
# Ship ManaVault's detector graph unchanged: detector.onnx from its bundle
# (`uv run python -m cardid.compare --fetch github:cfbender/manavault` downloads one).
CARDID_DETECTOR_ONNX=/home/you/oracle/data/bundles/<manavault-version>/detector.onnx
# ~30% of training pairs get binder glare (hot spots, pocket haze, overexposure).
CARDID_DEGRADATION=harsh-binder
CARDID_RETRAIN_EPOCHS=6
# ManaVault's scanner feeds search.onnx a gallery mask; MTG Vault's port does too.
CARDID_SEARCH_MASK=1
